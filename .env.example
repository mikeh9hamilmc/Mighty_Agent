# Mighty Agent — Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env

# ─── Required ───────────────────────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric user ID (send /start to @userinfobot to find it)
AUTHORIZED_USER_ID=your_numeric_telegram_user_id

# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Optional ───────────────────────────────────────────────────────────────
# Python executable (install.sh sets this to the venv path automatically)
PYTHON_CMD=python

# Max seconds a Python skill can run before being killed
SCRIPT_TIMEOUT_SEC=60

# Brave Search API — https://api-dashboard.search.brave.com/
# Free tier: 2,000 queries/month. Used by all agents for web search.
BRAVE_API_KEY=your_brave_api_key_here
