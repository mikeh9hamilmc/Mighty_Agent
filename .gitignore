node_modules/
scratch/
.env
logs/
*.log

# Legal sub-agent — ignore all documents and generated caches
# Only README.md is tracked so the folder exists in the repo
skills/legal/data/*
!skills/legal/data/README.md
skills/legal/data/.legal-cache/
skills/legal/memory/*
!skills/legal/memory/README.md

